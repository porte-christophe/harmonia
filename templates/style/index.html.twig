{% extends 'base.html.twig' %}

{% block title %}Tracks du style: {{ style.name }}{% endblock %}

{% block body %}

    <div class="h-100">
        <h1>Tracks du style: {{ style.name }}</h1>
        {% for track in style.tracks %}
            <li>
                <a href="{{ path('app_track_item', {'id' : track.id}) }}">
                    {{ track.title }}
                </a>
            </li>
        {% endfor %}
    </div>           
    
        
{% endblock %}
