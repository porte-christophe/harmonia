{% extends 'base.html.twig' %}

{% block title %}Track: {{ track.title }}{% endblock %}

{% block body %}

    <div class="h-100">
        <h1>{{ track.title }}</h1>
        {% for style in track.styles %}
            <a href="{{ path('app_style', {'id' : style.id}) }}">{{ style.name }}</a>
        {% endfor %}
    </div>   
    {% if app.user %}
        

        {% if isFav %}
            <button id="my-super-btn" data_trackId="{{ track.id }}">Retirer des favoris</button>
        {% else %}
            <button id="my-super-btn" data_trackId="{{ track.id }}">Ajouter aux Favoris</button>
        {% endif %}
        
         
        
    {% endif %}
                
    
        
{% endblock %}
